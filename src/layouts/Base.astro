---
import content from '../data/content.json';
import '../styles/global.css';

const { praktijk, contact, footer } = content;

export interface Props {
  title: string;
  description: string;
  /** Marks the current page so its nav link can be left out. */
  page?: 'home' | 'voetklachten' | 'diabetes-en-reuma' | 'privacy';
}

const { title, description, page = 'home' } = Astro.props;

/** '/virginiapedicure/' on GitHub Pages, '/' on a real domain. */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// The github.io address is a temporary preview, not the real site. Keeping it
// out of Google avoids a duplicate of the practice showing up in search results
// under the wrong address.
// AT LAUNCH ON THE REAL DOMAIN: set this to false (and see public/robots.txt).
const isPreview = true;

// One list, rendered twice: as the desktop row and inside the phone menu.
const links = [
  { tekst: 'Over mij', href: page === 'home' ? '#over-mij' : `${base}#over-mij` },
  { tekst: 'Tarieven', href: page === 'home' ? '#tarieven' : `${base}#tarieven` },
  { tekst: 'Praktisch', href: page === 'home' ? '#praktisch' : `${base}#praktisch` },
  { tekst: 'Voetklachten', href: `${base}voetklachten.html`, current: page === 'voetklachten' },
  {
    tekst: 'Diabetes & reuma',
    href: `${base}diabetes-en-reuma.html`,
    current: page === 'diabetes-en-reuma',
  },
  { tekst: 'Contact', href: page === 'home' ? '#contact' : `${base}#contact` },
];
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href={`${base}img/logo-mark.png`} />
    <link rel="apple-touch-icon" href={`${base}img/logo-mark.png`} />

    <!-- Self-hosted so no request ever leaves for a third party. Preloaded
         because both faces are used above the fold. -->
    <link
      rel="preload"
      href={`${base}fonts/mulish-var.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/newsreader-var.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#hoofdinhoud">Direct naar de inhoud</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={base}>
          <img
            src={`${base}img/logo-mark.png`}
            width="153"
            height="180"
            alt=""
           decoding="async"
          />
          <span>
            <span class="brand-name">{praktijk.naam}</span>
            <span class="brand-role">{praktijk.beroep}</span>
          </span>
        </a>

        <nav class="nav-desktop" aria-label="Hoofdmenu">
          {links.map((l) => (
            <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.tekst}</a>
          ))}
        </nav>

        <a class="header-phone" href={`tel:${contact.telefoon_bellen}`}>
          {contact.telefoon_weergave}
        </a>
      </div>

      {/*
        Phone menu. <details>/<summary> is native HTML: it opens and closes
        with no JavaScript, is keyboard-operable, and still works with scripts
        disabled. Hidden from 60rem up, where the row above takes over.
        The mobile header does not stick, so an open menu simply scrolls out
        of the way when a link jumps down the page.
      */}
      <details class="nav-mobile">
        <summary>
          <span class="nav-mobile-icon" aria-hidden="true"></span>
          Menu
        </summary>
        <nav class="nav-mobile-list" aria-label="Hoofdmenu">
          <a href={base}>Home</a>
          {links.map((l) => (
            <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.tekst}</a>
          ))}
        </nav>
      </details>
    </header>

    <main id="hoofdinhoud">
      <slot />
    </main>

    <div class="logo-strip">
      <img
        src={`${base}img/logo-full.jpg`}
        width="720"
        height="655"
        alt={`${praktijk.naam} — ${praktijk.beroep}. ${praktijk.tagline}.`}
        loading="lazy"
      />
    </div>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p style="margin:0">
          {praktijk.bedrijfsnaam} &middot; KvK {praktijk.kvk}
        </p>
        <nav class="footer-links" aria-label="Footer">
          <a href={`${base}voetklachten.html`}>{footer.voetklachten_tekst}</a>
          <a href={`${base}diabetes-en-reuma.html`}>{footer.diabetes_reuma_tekst}</a>
          <a href={`${base}privacy.html`}>{footer.privacy_tekst}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
