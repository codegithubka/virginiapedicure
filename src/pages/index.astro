---
import Base from '../layouts/Base.astro';
import content from '../data/content.json';

const {
  praktijk, contact, openingstijden, hero,
  over_mij, klachten, tarieven, praktisch, locatie, contact_sectie,
} = content;

const dagen = [
  ['Maandag', openingstijden.maandag],
  ['Dinsdag', openingstijden.dinsdag],
  ['Woensdag', openingstijden.woensdag],
  ['Donderdag', openingstijden.donderdag],
  ['Vrijdag', openingstijden.vrijdag],
  ['Zaterdag', openingstijden.zaterdag],
  ['Zondag', openingstijden.zondag],
];

/** "50,00" gets a euro sign; "In overleg" does not. */
const toonPrijs = (p: string) => (/\d/.test(p) ? `€ ${p}` : p);

const titel = `${praktijk.naam} — ${praktijk.beroep} in ${praktijk.plaats}`;
const omschrijving =
  `Medisch pedicure in Bergen NH. Behandeling in de salon en ambulant, bij u thuis. ` +
  `Alleen op afspraak. Bel ${contact.telefoon_weergave}.`;
---

<Base title={titel} description={omschrijving} page="home">
  {/* ---------------------------------------------------------------- hero */}
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>{hero.titel}</h1>
        <p class="hero-sub">{hero.ondertitel}</p>

        <p class="gold-rule" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="presentation">
            <path
              d="M12 21s-7.5-4.6-9.6-9A5.4 5.4 0 0 1 12 6.2 5.4 5.4 0 0 1 21.6 12c-2.1 4.4-9.6 9-9.6 9Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            />
          </svg>
        </p>

        <p class="tagline">{praktijk.tagline}</p>

        <p>{hero.intro}</p>

        <div class="btn-row">
          <a class="btn btn-primary" href={`tel:${contact.telefoon_bellen}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
            </svg>
            {hero.knop_bellen}
          </a>

          <a class="btn btn-secondary" href={contact.whatsapp}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
            </svg>
            {hero.knop_whatsapp}
          </a>
        </div>
      </div>

      {/* Placeholder only. Replace with Virginia's portrait — see README. */}
      <div class="img-slot" data-ratio="4x5">
        <strong>Foto volgt</strong>
        <span>Portret van Virginia aan het werk<br />Staand, ongeveer 1000 &times; 1250 px</span>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- over mij */}
  <section id="over-mij" class="band">
    <div class="wrap">
      <h2>{over_mij.kop}</h2>
      <p>{over_mij.alinea_1}</p>
      <p>{over_mij.alinea_2}</p>
    </div>
  </section>

  {/* ------------------------------------------------ behandelingen & tarieven */}
  <section id="tarieven">
    <div class="wrap">
      <h2>{tarieven.kop}</h2>

      <p>{klachten.intro}</p>
      <ul class="tick-list klachten-list">
        {klachten.lijst.map((k) => <li>{k}</li>)}
      </ul>
      <p><a href="/voetklachten.html">{klachten.link_tekst}</a></p>

      <dl class="tarieven">
        {tarieven.behandelingen.map((b) => (
          <div class="tarief">
            <dt class="tarief-naam">{b.naam}</dt>
            <dd class="tarief-prijs">{toonPrijs(b.prijs)}</dd>
            <dd class="tarief-beschrijving">{b.beschrijving}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ---------------------------------------------------- praktische informatie */}
  <section id="praktisch" class="band">
    <div class="wrap">
      <h2>{praktisch.kop}</h2>

      <ul class="tick-list">
        {praktisch.punten.map((p) => <li>{p}</li>)}
      </ul>

      <h3>Openingstijden</h3>
      <table class="uren">
        <tbody>
          {dagen.map(([dag, tijd]) => (
            <tr>
              <th scope="row">{dag}</th>
              <td class={tijd === 'Gesloten' ? 'dicht' : ''}>{tijd}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h3>{praktisch.annulering_kop}</h3>
      <p>{praktisch.annulering_tekst}</p>
    </div>
  </section>

  {/* ------------------------------------------------------------- locatie */}
  <section id="locatie">
    <div class="wrap">
      <h2>{locatie.kop}</h2>
      <p>{locatie.tekst}</p>

      <address>
        {praktijk.bedrijfsnaam}<br />
        {contact.straat}<br />
        {contact.postcode} {contact.woonplaats}
      </address>

      {contact.kaart_link && (
        <p style="margin-top:1.5rem">
          <a href={contact.kaart_link} rel="noopener">{locatie.kaart_link_tekst}</a>
        </p>
      )}
    </div>
  </section>

  {/* ------------------------------------------------------------- contact */}
  <section id="contact" class="band">
    <div class="wrap">
      <h2>{contact_sectie.kop}</h2>

      <p>{contact_sectie.tekst}</p>

      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn btn-primary" href={`tel:${contact.telefoon_bellen}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
          </svg>
          {hero.knop_bellen}
        </a>

        <a class="btn btn-secondary" href={contact.whatsapp}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
          </svg>
          {hero.knop_whatsapp}
        </a>
      </div>

      <ul class="contact-list" style="margin-top:2rem">
        <li>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
      </ul>
    </div>
  </section>
</Base>
