---
import Base from '../layouts/Base.astro';
import content from '../data/content.json';
import ContactKnoppen from '../components/ContactKnoppen.astro';

const { praktijk, contact, hero, voetklachten } = content;

const titel = `${voetklachten.titel} — ${praktijk.naam}`;
const omschrijving =
  'Uitleg over eelt, kloven, likdoorns en ingroeiende of ingegroeide nagels ' +
  'door medisch pedicure Virginia Scelso in Bergen NH.';
---

<Base title={titel} description={omschrijving} page="voetklachten">
  <section class="page-head">
    <div class="wrap">
      <h1>{voetklachten.titel}</h1>
      <p class="lead">{voetklachten.intro}</p>

      <p class="note">
        {voetklachten.disclaimer}
        {voetklachten.medische_melding && ' ' + voetklachten.medische_melding}
      </p>
    </div>
  </section>

  {voetklachten.klachten.map((k, i) => (
    <section class={i % 2 === 0 ? 'band' : ''}>
      <div class="wrap klacht">
        <h2>{k.kop}</h2>

        {k.alineas.map((a) => <p>{a}</p>)}

      </div>
    </section>
  ))}

  <section>
    <div class="wrap">
      <h2>Twijfelt u over uw voeten?</h2>
      <p>
        Belt u gerust, dan kijken we samen wat er nodig is. Een afspraak maken kan
        telefonisch of via WhatsApp.
      </p>

      <ContactKnoppen />
    </div>
  </section>
</Base>
